#!/bin/sh
# Layer 2 of main protection (see _meta/main-protection.md).
# Blocks any push from this machine that would update or delete main/master on the remote,
# whatever tool runs it: terminal, VS Code, a git GUI, Claude.
# Changes reach main only by merging a PR on GitHub.
#
# Activate once per clone:  git config core.hooksPath .githooks
# Deliberate one-off override (you, never Claude):  ALLOW_PUSH_MAIN=1 git push ...

remote="$1"
blocked=""

# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref being pushed
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) blocked="$blocked ${remote_ref#refs/heads/}" ;;
  esac
done

[ -z "$blocked" ] && exit 0

if [ "$ALLOW_PUSH_MAIN" = "1" ]; then
  echo "pre-push: ALLOW_PUSH_MAIN=1 set; allowing push to:$blocked" >&2
  exit 0
fi

cat >&2 <<EOF
pre-push: BLOCKED push to '$remote':$blocked
  main only changes by merging a PR on GitHub.
  Push a feature branch instead:  git push -u $remote HEAD:<branch-name>
  Then open a PR:                 gh pr create --base main
  (Deliberate override, user only: ALLOW_PUSH_MAIN=1 git push ...)
EOF
exit 1
